if __name__ == '__main__':
    print("轨迹预测器 v1.0 测试")
    print("=" * 50)

    predictor = TrajectoryPredictor(fps=30, max_lost_frames=30)

    # 模拟一段轨迹：先跟踪 20 帧，然后球飞出画面 15 帧，再回来
    print("\n[1] 正常跟踪 20 帧...")
    for f in range(0, 20):
        x = 500 + 5 * f
        y = 300 - 8 * f + 0.3 * f**2
        r = predictor.update((x, y), f)
        if f % 10 == 0:
            print(f"  frame {f}: state={r.state.name} pos=({r.current_position[0]:.0f},{r.current_position[1]:.0f})")

    print(f"\n[2] 球飞出画面，预测 15 帧...")
    for f in range(20, 35):
        r = predictor.update(None, f)
        if r.state == TrackState.PREDICTING and f % 5 == 0:
            print(f"  frame {f}: state=PREDICTING pos=({r.current_position[0]:.0f},{r.current_position[1]:.0f}) conf={r.confidence:.2f}")

    print(f"\n[3] 球重新入画...")
    # 模拟球从预测位置附近出现（加一点噪声）
    px, py = predictor.parabolic.predict(35)
    r = predictor.update((px + 5, py - 3), 35)
    print(f"  frame 35: state={r.state.name} gap_fills={len(r.gap_fills)} 帧")
    if r.gap_fills:
        print(f"  补帧范围: frame {r.gap_fills[0].frame} ~ {r.gap_fills[-1].frame}")
        print(f"  补帧示例: frame {r.gap_fills[0].frame} → ({r.gap_fills[0].x:.0f},{r.gap_fills[0].y:.0f}) conf={r.gap_fills[0].confidence:.2f}")

    print(f"\n[4] 超时测试...")
    predictor.reset()
    for f in range(0, 10):
        r = predictor.update((500 + f*10, 300), f)
    for f in range(10, 60):
        r = predictor.update(None, f)
    print(f"  丢失 50 帧后: state={r.state.name}  (max_lost=30)")

    print(f"\n统计:")
    print(f"  总预测帧: {predictor.total_predictions}")
    print(f"  成功重捕获: {predictor.successful_reacquisitions}")
    print("\n测试完成。")